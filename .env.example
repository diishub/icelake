# Copy to .env and replace every value before using real data.
COMPOSE_PROJECT_NAME=psu-lakehouse
POSTGRES_USER=psu
POSTGRES_PASSWORD=change-me
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_BUCKET=psu-lakehouse
POLARIS_REALM=PSU
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=change-me
POLARIS_CATALOG=psu
# TLS keystore password and the cluster internal secret. Both are generated
# local values; neither protects anything outside this host.
TRINO_KEYSTORE_PASSWORD=change-me
TRINO_INTERNAL_SECRET=change-me

TRINO_HOST_PORT=8086
TRINO_INGESTION_USERNAME=nifi
TRINO_INGESTION_PASSWORD=change-me
# Table maintenance runs as its own Trino identity: it compacts and expires
# data it is not allowed to read.
TRINO_MAINTENANCE_USERNAME=maintenance
TRINO_MAINTENANCE_PASSWORD=change-me
PSU_ADMIN_USERNAME=psu-admin
PSU_ADMIN_PASSWORD=change-me
PSU_ANALYST_USERNAME=analyst
PSU_ANALYST_PASSWORD=change-me
PSU_VIEWER_COUNT=3
PSU_VIEWER_1_USERNAME=viewer
PSU_VIEWER_1_PASSWORD=change-me
PSU_VIEWER_1_ORG_UNIT=*
PSU_VIEWER_2_USERNAME=viewer-eng
PSU_VIEWER_2_PASSWORD=change-me
PSU_VIEWER_2_ORG_UNIT=eng
PSU_VIEWER_3_USERNAME=viewer-med
PSU_VIEWER_3_PASSWORD=change-me
PSU_VIEWER_3_ORG_UNIT=med
# Password Superset uses to authenticate to Trino before impersonating the
# signed-in user.
SUPERSET_TRINO_PASSWORD=change-me

SUPERSET_SECRET_KEY=change-me-at-least-32-bytes
QDRANT_API_KEY=change-me
NIFI_USERNAME=psu-admin
NIFI_PASSWORD=change-me-at-least-12-characters

# Source database for NiFi metadata-driven ingestion. Leave every value unset
# unless a source is actually being ingested; an unset source is simply
# disabled.
#
# The host is checked against config/guardrail/allowed-source-hosts.txt before
# NiFi starts, and a host on config/guardrail/forbidden-source-hosts.txt is
# refused outright. This stack is a development environment with no Trino
# authentication, no SSO and no tested restore, so it must not be pointed at a
# production system holding real personal data. See docs/SOURCE_GUARDRAIL_TH.md.
#
# PSU_SOURCE_DB_HOST=source-sim
# PSU_SOURCE_DB_PORT=5432
# PSU_SOURCE_DB_NAME=change-me
# PSU_SOURCE_DB_USER=change-me
# PSU_SOURCE_DB_PASSWORD=change-me

# Synthetic source database (service `source-sim`). Generated data only --
# this is what ingestion is developed and tested against, so that no real
# system is involved. Both passwords are required; Compose refuses to start
# without them.
SOURCE_SIM_USER=source_sim
SOURCE_SIM_PASSWORD=change-me
SOURCE_SIM_DB=lakehouse_sim
SOURCE_SIM_HOST_PORT=5433
# Read-only login the pipeline uses. Must differ from SOURCE_SIM_PASSWORD:
# the pipeline is not the database owner.
SOURCE_SIM_READER_USER=ingest_reader
SOURCE_SIM_READER_PASSWORD=change-me

# Password for the platform_app role, the least-privilege login the ingestion
# pipeline uses against the control-plane database. Not the PostgreSQL
# superuser: the pipeline records what it did, it does not administer the
# database.
PLATFORM_DB_PASSWORD=change-me

# Password for platform_trino, the read-only login Trino uses to expose the
# control plane as a catalog. SELECT only.
PLATFORM_READ_PASSWORD=change-me

#===========================================#
# Portal sign-in (PSU Passport)             #
#===========================================#
# Only needed to run the psu-auth service:
#   docker compose --profile auth up -d psu-auth
# Without these the rest of the stack starts normally and the portal simply
# shows no sign-in control.

# Where browsers reach the portal. Must match the redirect URI registered with
# PSU Passport, which is this value plus /auth/callback.
AUTH_PUBLIC_ORIGIN=http://localhost:8085
# Session lifetime in seconds (default 28800 = 8 hours).
AUTH_SESSION_TTL_SECONDS=
# Leave true. Browsers accept Secure cookies on http://localhost, so loopback
# needs no exception; set false only for a deployment reached by plain HTTP on
# another host, which has a bigger problem than this flag.
AUTH_COOKIE_SECURE=true

# PSU Passport OpenID Connect client. Registered per deployment; the client
# secret belongs here and nowhere else.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
# Claim names are deployment specific. Dotted paths are supported for the
# campus claim, which is optional: without it the campus databases below are
# tried in order instead.
OIDC_USERNAME_CLAIM=preferred_username
OIDC_NAME_CLAIM=name
OIDC_EMAIL_CLAIM=email
OIDC_CAMPUS_CLAIM=
OIDC_POST_LOGOUT_REDIRECT_URI=

# PSU API gateway, used after sign-in to resolve whether the person is a
# student or staff and which faculty they belong to. Keys are read by the
# psu-auth service only: never commit them, never put them in a browser bundle.
API_PSU_GATEWAY=https://api-gateway.psu.ac.th:8443
API_STUDENT_KEY=
API_STAFF_KEY=
# Campus databases tried in order for a student whose campus is unknown
# (default 01 Hat Yai, 02 Pattani, 03 Phuket, 04 Surat Thani, 05 Trang).
PSU_CAMPUS_CODES=
PSU_API_TIMEOUT_MS=5000

# Password for the least-privilege identity_app database role. Required by the
# platform-migrate service, so set it even if sign-in is not enabled yet.
IDENTITY_DB_PASSWORD=<PLACEHOLDER>

# Email-and-password sign-in, alongside PSU Passport. There is no self-service
# registration: accounts are created only by scripts/create-password-account.sh,
# which an administrator runs. See docs/AUTH_PSU_PASSPORT_TH.md.
#
# bcrypt cost factor for password hashes (4-15). 12 costs roughly 250ms per
# hash on typical hardware; raise it only if that is measured to be too fast
# for comfort, since every unit of cost roughly doubles the time.
PASSWORD_LOGIN_BCRYPT_COST=12
# Failed attempts allowed per email before a 429 is returned.
PASSWORD_LOGIN_MAX_ATTEMPTS=8
# Window the above is counted over, in seconds (default 900 = 15 minutes).
# The limiter is in-memory and per-process: it resets on a restart and does
# not share state across replicas if this service is ever scaled beyond one.
PASSWORD_LOGIN_WINDOW_SECONDS=900

#===========================================#
# Report workspace sign-in (Superset)       #
#===========================================#
# Turns Superset over to PSU Passport as well, so a person who signed in to the
# portal is not asked for a second password. Off by default: a machine with no
# registered client keeps the local accounts created by bootstrap_users.py.
#
# Register this redirect URI with PSU Passport:
#   <where browsers reach Superset>/oauth-authorized/psu
# It is a different path from the portal's, so either add both to one client or
# register a second client.
SUPERSET_OAUTH_ENABLED=false
# Defaults to OIDC_ISSUER when left blank.
SUPERSET_OAUTH_ISSUER=
SUPERSET_OAUTH_CLIENT_ID=
SUPERSET_OAUTH_CLIENT_SECRET=
SUPERSET_OAUTH_SCOPE=openid profile email
SUPERSET_OAUTH_USERNAME_CLAIM=preferred_username
SUPERSET_OAUTH_NAME_CLAIM=name
SUPERSET_OAUTH_EMAIL_CLAIM=email
# Role given to an account the first time it signs in. Gamma is Superset's
# read-only role; it grants no data, because data access is decided by Trino
# and OPA from the grants recorded in identity.app_user.
SUPERSET_OAUTH_DEFAULT_ROLE=Gamma
# Leave false unless PSU Passport actually carries the groups below. With role
# sync on, every promotion an administrator makes in Superset is reverted at
# that person's next sign-in.
SUPERSET_OAUTH_ROLE_SYNC=false
SUPERSET_OAUTH_ADMIN_GROUP=psu-data-hub-admin
SUPERSET_OAUTH_ANALYST_GROUP=psu-data-hub-analyst
SUPERSET_OAUTH_VIEWER_GROUP=psu-data-hub-viewer
SUPERSET_COOKIE_SECURE=true

#===========================================#
# Embedded dashboards (guest tokens)        #
#===========================================#
# Lets the portal show a Superset dashboard inline for a signed-in
# viewer_exec/analyst account instead of a second Superset login. The
# embedded query still runs as that account's own Trino identity (guest
# tokens carry psu_username, impersonated the same way an interactive
# Superset login already is) -- this does not widen what anyone can see.
#
# Signs the short-lived guest token. Never reused for anything else.
SUPERSET_GUEST_TOKEN_SECRET=<PLACEHOLDER>
# Where the psu-auth service reaches Superset's REST API to mint a guest
# token, and the origin the browser embeds the dashboard iframe from.
SUPERSET_EMBED_ORIGIN=http://localhost:8088
# A dedicated Superset account used only to mint guest tokens -- see
# config/superset/bootstrap_embed.py, which grants it can_grant_guest_token
# and nothing else. Not an admin credential.
SUPERSET_EMBED_SERVICE_USERNAME=psu-embed
SUPERSET_EMBED_SERVICE_PASSWORD=<PLACEHOLDER>
# Which dashboards config/superset/bootstrap_embed.py enables for embedding,
# as "key=slug" pairs (comma separated) -- the key is what the portal asks
# for, the slug is the dashboard's own Superset slug. Add another dashboard
# here (and rerun superset-init) without touching any route or portal code.
SUPERSET_EMBED_DASHBOARD_SLUGS=ops=psu-platform-operations
# "key=uuid" pairs, comma separated -- copy this from what bootstrap_embed.py
# prints ("SUPERSET_EMBED_DASHBOARDS=ops=<uuid>"). Not a secret, just
# generated per install, which is why it's blank here.
SUPERSET_EMBED_DASHBOARDS=
