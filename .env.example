# Copy to .env and replace every value before using real data.
COMPOSE_PROJECT_NAME=psu-lakehouse
POSTGRES_USER=psu
POSTGRES_PASSWORD=change-me
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_BUCKET=psu-lakehouse
POLARIS_REALM=PSU
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=change-me
POLARIS_CATALOG=psu
TRINO_HOST_PORT=8086
PSU_ADMIN_USERNAME=psu-admin
PSU_ADMIN_PASSWORD=change-me
PSU_ANALYST_USERNAME=analyst
PSU_ANALYST_PASSWORD=change-me
PSU_VIEWER_USERNAME=viewer
PSU_VIEWER_PASSWORD=change-me
SUPERSET_SECRET_KEY=change-me-at-least-32-bytes
QDRANT_API_KEY=change-me
NIFI_USERNAME=psu-admin
NIFI_PASSWORD=change-me-at-least-12-characters

# CPT corpus ingestion pipeline (cpt_ingest.py)
# RustFS endpoint reachable from the host (compose maps :9000).
RUSTFS_ENDPOINT=http://localhost:9000
# ThaiLLM Data Repository: login uses ThaiID (national digital identity), not a
# site password. Run `python cpt_ingest.py login` to open a visible browser and
# complete the ThaiID flow once; the script caches the session under
# runtime/thaillm/. No credentials are stored in this file.
# Character budget for a run (counted as chars, a proxy for tokens per the
# chosen counting method). Default target = 1,000,000,000 (1B).
CPT_TARGET_CHARS=1000000000
# S3 bucket + key prefix where parquet shards are written.
CPT_OUTPUT_BUCKET=psu-lakehouse
CPT_OUTPUT_PREFIX=cpt/thaillm
