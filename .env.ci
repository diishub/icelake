# Throwaway values for CI only.
#
# Every value here is fake, generated for this file, and used exclusively by
# ephemeral runner containers that are destroyed at the end of each CI job --
# nothing here ever reaches a real deployment, a browser, or a person.
# Copying this file to .env for any real use is exactly the mistake
# docs/AUTH_PSU_PASSPORT_TH.md and the September incident (docs/INCIDENT_2026-09-03_TH.md)
# both warn against: never point this stack at a real host or reuse a
# generated value outside the container it was generated for.
#
# Kept in lockstep with .env.example by hand: a variable added there needs a
# safe value added here too, or the CI stack fails to start with a clear
# "must be set" error rather than silently skipping the check .env.example
# documents.
#
# None of these start with "change-me": bootstrap_users.py and
# scripts/create-password-account.sh both refuse a password with that literal
# prefix on purpose (see the "Superset password placeholder guard" note in
# docs/RUNBOOK.md), so a CI value has to look like a real generated secret,
# not a placeholder, even though it is exactly as disposable as one.
COMPOSE_PROJECT_NAME=psu-lakehouse-ci
POSTGRES_USER=psu
POSTGRES_PASSWORD=ci-postgres-9f3a1c7d2e6b4508
RUSTFS_ACCESS_KEY=ci-rustfs-access-4d2f8a91
RUSTFS_SECRET_KEY=ci-rustfs-secret-7b1e5c3a9f0d2468
RUSTFS_BUCKET=psu-lakehouse
POLARIS_REALM=PSU
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=ci-polaris-secret-2a6f9d1b8e4c0735
POLARIS_CATALOG=psu

TRINO_KEYSTORE_PASSWORD=ci-keystore-8e2a4d6f1b9c3057
TRINO_INTERNAL_SECRET=ci-internal-3f7b1a5d9e2c6084

TRINO_HOST_PORT=8086
TRINO_INGESTION_USERNAME=nifi
TRINO_INGESTION_PASSWORD=ci-nifi-pw-6c2e8a4f0b1d9573
TRINO_MAINTENANCE_USERNAME=maintenance
TRINO_MAINTENANCE_PASSWORD=ci-maint-pw-1d5f9b3e7a0c2648
PSU_ADMIN_USERNAME=psu-admin
PSU_ADMIN_PASSWORD=ci-admin-pw-9a3c7e1f5b0d2846
PSU_ANALYST_USERNAME=analyst
PSU_ANALYST_PASSWORD=ci-analyst-pw-4b8d0f2a6c1e3957
PSU_VIEWER_COUNT=3
PSU_VIEWER_1_USERNAME=viewer
PSU_VIEWER_1_PASSWORD=ci-viewer1-pw-2e6a0c4f8b1d3759
PSU_VIEWER_1_ORG_UNIT=*
PSU_VIEWER_2_USERNAME=viewer-eng
PSU_VIEWER_2_PASSWORD=ci-viewer2-pw-5f9b1d3a7c0e2648
PSU_VIEWER_2_ORG_UNIT=eng
PSU_VIEWER_3_USERNAME=viewer-med
PSU_VIEWER_3_PASSWORD=ci-viewer3-pw-8c0e2a4d6f1b3957
PSU_VIEWER_3_ORG_UNIT=med
SUPERSET_TRINO_PASSWORD=ci-superset-trino-pw-3a7c9e1f5b0d2648

SUPERSET_SECRET_KEY=ci-superset-secret-key-at-least-32-bytes-long-9f2a6c
QDRANT_API_KEY=ci-qdrant-key-6d0f2b4a8c1e3957
NIFI_USERNAME=psu-admin
NIFI_PASSWORD=ci-nifi-admin-pw-at-least-12-chars

# No real or simulated source host is ever configured in CI: nothing here
# needs the ingestion pipeline to actually connect to a source database, only
# to prove the guardrail and the control-plane registry behave correctly.

SOURCE_SIM_USER=source_sim
SOURCE_SIM_PASSWORD=ci-source-sim-pw-1b5d9f3a7c0e2846
SOURCE_SIM_DB=lakehouse_sim
SOURCE_SIM_HOST_PORT=5433
SOURCE_SIM_READER_USER=ingest_reader
SOURCE_SIM_READER_PASSWORD=ci-reader-pw-4e8a0c2f6b1d3957

PLATFORM_DB_PASSWORD=ci-platform-app-pw-7a1c3e5f9b0d2648
PLATFORM_READ_PASSWORD=ci-platform-read-pw-0d4f6a8c2e1b3957

# Portal sign-in. PSU Passport (OIDC) and Superset OAuth are both left
# unconfigured in CI on purpose: neither has a real client to test against,
# and the code is specifically designed to start cleanly without one (see
# services/auth/src/config.ts and docs/AUTH_PSU_PASSPORT_TH.md). Only the
# email-and-password path and the identity schema itself are exercised here.
AUTH_PUBLIC_ORIGIN=http://localhost:8085
AUTH_SESSION_TTL_SECONDS=
AUTH_COOKIE_SECURE=true

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
OIDC_NAME_CLAIM=name
OIDC_EMAIL_CLAIM=email
OIDC_CAMPUS_CLAIM=
OIDC_POST_LOGOUT_REDIRECT_URI=

API_PSU_GATEWAY=https://api-gateway.psu.ac.th:8443
API_STUDENT_KEY=
API_STAFF_KEY=
PSU_CAMPUS_CODES=
PSU_API_TIMEOUT_MS=5000

IDENTITY_DB_PASSWORD=ci-identity-app-pw-3f7b9d1e5a0c2846

PASSWORD_LOGIN_BCRYPT_COST=4
PASSWORD_LOGIN_MAX_ATTEMPTS=8
PASSWORD_LOGIN_WINDOW_SECONDS=900

SUPERSET_OAUTH_ENABLED=false
SUPERSET_OAUTH_ISSUER=
SUPERSET_OAUTH_CLIENT_ID=
SUPERSET_OAUTH_CLIENT_SECRET=
SUPERSET_OAUTH_SCOPE=openid profile email
SUPERSET_OAUTH_USERNAME_CLAIM=preferred_username
SUPERSET_OAUTH_NAME_CLAIM=name
SUPERSET_OAUTH_EMAIL_CLAIM=email
SUPERSET_OAUTH_DEFAULT_ROLE=Gamma
SUPERSET_OAUTH_ROLE_SYNC=false
SUPERSET_OAUTH_ADMIN_GROUP=psu-data-hub-admin
SUPERSET_OAUTH_ANALYST_GROUP=psu-data-hub-analyst
SUPERSET_OAUTH_VIEWER_GROUP=psu-data-hub-viewer
SUPERSET_COOKIE_SECURE=true
