server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    server_tokens off;
    # Redirects carry a path only. nginx listens on 80 inside the container but
    # is published on another host port (8085), so an absolute Location built
    # from its own port sends the browser to the wrong one.
    absolute_redirect off;

    # frame-src is the one exception to same-origin-only: it lets the
    # executive/analyst embedded-dashboard panel (the portal's /reports page,
    # /auth/embeds/ops) mount a Superset iframe. PORTAL_FRAME_SRC is filled
    # from SUPERSET_EMBED_ORIGIN by the nginx image's envsubst step at start
    # (compose.yaml, psu-portal), so the loopback and "public" deployments
    # each allow exactly their own Superset origin.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; frame-src ${PORTAL_FRAME_SRC}; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;

    # The HTML document is never stored, the assets beside it are revalidated,
    # and the build's hashed bundles are kept for good.
    #
    # "no-cache" already requires a browser to check back before reusing a copy,
    # and that is the right policy for the stylesheet, the script and the fonts:
    # they revalidate cheaply and answer 304 when unchanged. It is not enough
    # for the page itself, because a copy cached before this header existed is
    # still governed by the heuristic that applied when it was stored, and that
    # heuristic can hold a stale page for hours with no way to tell from here.
    # "no-store" on the document removes the possibility entirely, for 34 KB a
    # navigation.
    #
    # Pages have clean URLs (/review, /login): anything without a file
    # extension is a document. /_next/static/ holds content-hashed files whose
    # name changes whenever their content does, so they never need revalidating.
    #
    # "if" is avoided inside location blocks; setting a variable in the server
    # block is one of the two uses that are safe. It also keeps the security
    # headers above in force: an add_header inside a location would drop them.
    set $cache_policy "no-cache";
    if ($uri ~* "\.html$") { set $cache_policy "no-store"; }
    if ($uri !~ "\.[A-Za-z0-9]+$") { set $cache_policy "no-store"; }
    if ($uri ~ "^/_next/static/") { set $cache_policy "public, max-age=31536000, immutable"; }
    add_header Cache-Control $cache_policy always;


    # The portal is a Next.js static export (portal/): /review is review.html
    # on disk. try_files serves it in place, without a redirect, so the URL in
    # the address bar stays the one "next" was computed against.
    location / {
        try_files $uri $uri.html =404;
    }
    # Not via the index directive: that is an internal redirect to /index.html,
    # which the redirect below would bounce straight back to /.
    location = / {
        try_files /index.html =404;
    }
    error_page 404 /404.html;

    # Bookmarks and links from before the clean URLs. Matches only what a
    # browser asks for: the try_files lookup above does not come back here.
    location = /index.html {
        return 301 /;
    }
    location ~ ^/(login|upload|review|publish|reports|admin)\.html$ {
        return 301 /$1$is_args$args;
    }


    # Sign-in. The portal is static files and cannot hold a client secret or
    # exchange an authorization code, so PSU Passport is handled by the
    # psu-auth service and proxied here, same-origin, which keeps the session
    # cookie on this host and needs no CSP exception.
    #
    # The upstream is resolved per request through a variable, so nginx starts
    # and serves the portal whether or not psu-auth is running: without it,
    # /auth/me answers 502 and the portal hides the sign-in controls rather
    # than showing one that cannot work.
    location /auth/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $auth_upstream http://psu-auth:8087;
        proxy_pass $auth_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
    # Anonymous users only learn whether the report UI responds. The upstream
    # endpoint returns a two-byte "OK" and does not disclose service versions.
    location = /api/health/reports {
        access_log off;
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $reports_upstream http://superset:8088;
        proxy_pass $reports_upstream/health;
        proxy_http_version 1.1;
        proxy_set_header Host superset;
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
        proxy_send_timeout 2s;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Vary;
        proxy_hide_header Content-Type;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        add_header Content-Type "text/plain; charset=utf-8" always;
        add_header X-Content-Type-Options "nosniff" always;
    }


    # Notes that live beside the code they document are not part of the site.
    # The portal root is served as-is, so a Markdown file dropped in it would
    # otherwise be public the moment it is written.
    location ~* \.md$ {
        return 404;
    }
    location ~ /\. {
        deny all;
    }
}
