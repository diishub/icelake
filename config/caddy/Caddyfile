# Public-facing TLS termination + HTTP Basic Auth gate for the two services
# this deployment exposes to the internet: the PSU Data Hub portal and
# Superset. Everything else (Trino, NiFi, RustFS console, Polaris, Qdrant)
# stays loopback-only per docs/ARCHITECTURE.md / README §11 -- reach those
# through an SSH tunnel, not through this proxy.
#
# Superset gets its own port (not a URL sub-path) on the same hostname,
# because reverse-proxying Superset at a sub-path is not reliably supported
# upstream (broken static assets / redirects reported even with
# ENABLE_PROXY_FIX + x_prefix set) -- see docs/ARCHITECTURE.md.

{$PUBLIC_DOMAIN} {
	basic_auth * {
		{$PROXY_BASIC_AUTH_USER} {$PROXY_BASIC_AUTH_HASH}
	}
	reverse_proxy psu-portal:80
}

{$PUBLIC_DOMAIN}:{$SUPERSET_PUBLIC_PORT} {
	basic_auth * {
		{$PROXY_BASIC_AUTH_USER} {$PROXY_BASIC_AUTH_HASH}
	}
	reverse_proxy superset:8088
}
